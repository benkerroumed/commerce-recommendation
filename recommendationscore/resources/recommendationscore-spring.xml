<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">


    <bean id="recommendationscoreSystemSetup" class="com.recommendations.core.setup.RecommendationscoreSystemSetup">
    </bean>

    <bean id="origamiSearchStrategy" parent="defaultFacetSearchStrategy">
        <property name="facetSearchQueryConverter" ref="facetSearchQueryConverter" />
        <property name="facetSearchResultConverter" ref="origamiSearchResultConverter" />
    </bean>

    <bean id="origamiSearchResultPopulator" class="com.recommendations.core.populator.OrigamiSearchResultPopulator"/>

    <bean id="origamiSearchResultConverter" parent="abstractPopulatingConverter">
        <property name="targetClass" value="com.recommendations.core.search.OrigamiSearchResult" />
        <property name="populators">
            <list>
                <ref bean="origamiSearchResultPopulator" />
            </list>
        </property>
    </bean>

    <bean id="origamiQuerySolrValueProvider"
          class="com.recommendations.core.provider.OrigamiQuerySolrValueProvider"
          parent="abstractValueResolver"/>

    <bean id="origamiQueryScoreSolrValueProvider"
          class="com.recommendations.core.provider.OrigamiQueryScoreSolrValueProvider"
          parent="abstractValueResolver"/>

    <bean class="com.recommendations.core.facade.impl.OrigamiFacadeImpl" name="origamiFacade" parent="defaultCommerceSolrFacetSearchProductSearchStrategy"/>


</beans>
